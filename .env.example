# development | production
APP_ENV=development
# Demo login/seed endpoints. Defaults to true in development, false in production.
DEMO_MODE=true
AUTO_SEED=true
# REQUIRED in production: 32+ random chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Postgres in production, e.g. postgresql://user:pass@host:5432/cloudsentinel (empty = local SQLite)
DATABASE_URL=
# Optional error tracking
SENTRY_DSN=
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Deprecated, MongoDB path will be removed
DATA_STORE=sqlite
MONGODB_URI=
MONGODB_DATABASE=cloudsentinel
