diff --git a/deploy/nginx.conf b/deploy/nginx.conf
new file mode 100644
index 0000000..854b8ac
--- /dev/null
+++ b/deploy/nginx.conf
@@ -0,0 +1,35 @@
+# CloudSentinel enforcement point: every request to a protected host is checked via auth_request.
+events {}
+http {
+  upstream cs_backend { server backend:8000; }
+  upstream sample_app { server sample:80; }
+
+  server {
+    listen 80;
+    server_name hr.localtest.me;
+
+    location = /_cs_verify {
+      internal;
+      proxy_pass http://cs_backend/api/enforce/verify;
+      proxy_pass_request_body off;
+      proxy_set_header Content-Length "";
+      proxy_set_header X-Forwarded-Host $host;
+      proxy_set_header X-Original-Method $request_method;
+      proxy_set_header Authorization $http_authorization;
+      proxy_set_header Cookie $http_cookie;
+    }
+
+    location / {
+      auth_request /_cs_verify;
+      auth_request_set $cs_user $upstream_http_x_cloudsentinel_user;
+      proxy_set_header X-Forwarded-User $cs_user;
+      proxy_set_header X-Forwarded-Host $host;
+      proxy_pass http://sample_app;
+      error_page 401 = @login;
+      error_page 403 = @denied;
+    }
+
+    location @login  { return 302 http://login.localtest.me:8000/api/enforce/login?next=http://$host$request_uri; }
+    location @denied { default_type text/plain; return 403 "Blocked by CloudSentinel Zero Trust policy.\n"; }
+  }
+}
